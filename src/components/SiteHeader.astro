---
import Icon from '../components/Icon.astro';
import { NAV_LINKS, SITE_NAME } from '../lib/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') + '/';
const isHome = pathname === '//'; // root has no trailing segment
const current = (href: string) =>
  href === '/' ? isHome : pathname === href || pathname.startsWith(href);

const navIcons: Record<string, string> = {
  '/pity-calculator/': 'calculator',
  '/wishes-needed/': 'scale',
  '/savings-planner/': 'coins',
  '/simulator/': 'dice',
  '/guides/': 'book',
  '/faq/': 'help-circle',
};
---
<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand" aria-label={`${SITE_NAME} - home`}>
      <svg class="logo-star" width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
        <path
          d="M32 6 C34.5 23 41 29.5 58 32 C41 34.5 34.5 41 32 58 C29.5 41 23 34.5 6 32 C23 29.5 29.5 23 32 6 Z"
          fill="#e8c268"></path>
        <circle cx="48" cy="14" r="3" fill="#6fd3c7"></circle>
      </svg>
      Pity<em>Hub</em>
    </a>
    <button
      class="nav-toggle"
      id="navToggle"
      aria-expanded="false"
      aria-controls="mainNav"
      type="button"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
      Menu
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>
            <Icon name={navIcons[link.href] ?? 'star4'} size={14} />
            {link.label}
          </a>
        ))
      }
      <a href="/pity-calculator/" class="nav-cta"><Icon name="target" size={14} /> Calculate</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mainNav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });
  // Close the mobile menu after choosing a destination.
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
